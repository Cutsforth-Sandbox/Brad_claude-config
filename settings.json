{
  "permissions": {
    "allow": [
      "mcp__codegraph__*",
      "Bash(python3 ~/.claude/skills/check-hw-docs/checker.py:*)",
      "Bash(python3 ~/.claude/skills/md-to-pdf/build.py:*)",
      "Bash(python ~/.claude/skills/md-to-pdf/build.py:*)",
      "Bash(py ~/.claude/skills/md-to-pdf/build.py:*)",
      "Bash(pdftotext:*)",
      "Bash(pdfinfo:*)",
      "Bash(ls:*)",
      "mcp__claude_ai_Atlassian_Rovo__getJiraIssue",
      "mcp__claude_ai_Atlassian_Rovo__searchJiraIssuesUsingJql",
      "mcp__claude_ai_Atlassian_Rovo__getConfluencePage",
      "mcp__claude_ai_Atlassian_Rovo__searchConfluenceUsingCql",
      "mcp__claude_ai_Atlassian_Rovo__getPagesInConfluenceSpace",
      "mcp__claude_ai_Atlassian_Rovo__getAccessibleAtlassianResources",
      "mcp__claude_ai_Atlassian_Rovo__atlassianUserInfo"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git -C * commit*)",
      "Bash(git --no-pager commit:*)",
      "Bash(git -c * commit*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/git-commit-checklist.py\"",
            "if": "Bash(git *)",
            "shell": "bash"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v codegraph >/dev/null 2>&1 && exec codegraph prompt-hook; command -v codegraph.cmd >/dev/null 2>&1 && exec codegraph.cmd prompt-hook; exit 0",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/plan-outline-check.py\"",
            "if": "Write(~/.claude/plans/*.md)",
            "shell": "bash"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/plan-outline-check.py\"",
            "if": "Edit(**/plans/*.md)",
            "shell": "bash"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gitkraken-hooks@gitkraken": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark"
}
