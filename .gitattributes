# This repo syncs between Windows and Linux peers. Normalizing to LF in the working tree
# keeps a peer with core.autocrlf=false from committing CRLF, which would break a shebang
# on the Linux side.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf

# Fonts are binary; never let eol normalization touch them.
*.ttf binary
